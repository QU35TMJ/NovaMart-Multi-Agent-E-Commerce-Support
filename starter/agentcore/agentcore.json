{
  "name": "udacity",
  "version": 1,
  "runtimes": [
    {
      "name": "agentcore_runtime",
      "build": "CodeZip",
      "entrypoint": "agent_orchestrator.py",
      "codeLocation": "build/runtime/",
      "runtimeVersion": "PYTHON_3_12",
      "instrumentation": {
        "enableOtel": false
      },
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "executionRoleArn": "arn:aws:iam::008167025018:role/udacity-agentcore-agentcore-role",
      "envVars": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "PROJECT_NAME",
          "value": "udacity-agentcore"
        },
        {
          "name": "RETURNS_KB_ID",
          "value": "HQ0RQAJGCE"
        },
        {
          "name": "SHIPPING_KB_ID",
          "value": "5L5WRUQMTL"
        },
        {
          "name": "WARRANTY_KB_ID",
          "value": "0RN8F5GPFS"
        },
        {
          "name": "AGENT_LOG_GROUP",
          "value": "/aws/bedrock/agentcore/udacity-agentcore"
        },
        {
          "name": "GUARDRAIL_ID",
          "value": "vs36e5w5j0sh"
        },
        {
          "name": "GUARDRAIL_VERSION",
          "value": "1"
        },
        {
          "name": "AGENT_LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "AGENT_LOG_TO_CLOUDWATCH",
          "value": "true"
        },
        {
          "name": "AGENT_TRACING_ENABLED",
          "value": "true"
        },
        {
          "name": "AGENT_TRACE_SAMPLING_RATE",
          "value": "1.0"
        }
      ]
    }
  ]
}
